// The shape of a running pine. Four operating-system processes and one data
// structure. Everything that decides anything is in the daemon; every frontend
// is a painter that is told what to paint.
//
// Generated with `make docs'. Colours are pine's own shipped theme, ef-dream.

digraph pine {
  rankdir=LR; splines=spline; compound=true; newrank=true;
  graph [fontname="sans-serif", fontsize=22, ranksep=1.1, nodesep=0.45,
         bgcolor="#232025", labelloc=t, fontcolor="#efd5c5",
         label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="3">
           <tr><td colspan="2"><font point-size="24" color="#efd5c5">pine &#8212; four processes, one tree</font></td></tr>
           <tr><td align="right"><font color="#51b04f" point-size="16">&#9473;&#9473;</font></td>
               <td align="left"><font color="#8f8886" point-size="13">read / write / watch</font></td></tr>
           <tr><td align="right"><font color="#ffaacf" point-size="16">&#9473;&#9473;</font></td>
               <td align="left"><font color="#8f8886" point-size="13">the daemon pushes a surface</font></td></tr>
           <tr><td align="right"><font color="#57b0ff" point-size="16">&#9473;&#9473;</font></td>
               <td align="left"><font color="#8f8886" point-size="13">a frontend sends what happened</font></td></tr>
           <tr><td colspan="2"><font color="#8f8886" point-size="12">a dashed border is an operating-system process of its own, and every<br/>arrow across one is an asynchronous tell both ways, so neither side<br/>can hang the other and only data crosses</font></td></tr>
         </table>>];
  node  [fontname="sans-serif", fontsize=14, shape=box, style="rounded,filled",
         color="#635850", fontcolor="#efd5c5", fillcolor="#322f34",
         margin="0.20,0.12"];
  edge  [fontname="sans-serif", fontsize=12, color="#8f8886",
         fontcolor="#8f8886", penwidth=1.2];

  subgraph cluster_daemon {
    label="the daemon - one headless image, no display";
    labeljust=l; fontsize=17; fontcolor="#b0a0cf";
    color="#635850"; style="rounded,dashed"; penwidth=2;

    prov [label="providers\lfile, sh, env, out, clock\lprocfs, pipewire, backlight\llogind, networkmanager\lmpris, niri\l",
          fillcolor="#3b393e"];
    store [label="store: sqlite\lone table, one thread\l:keep persists, code never does\l",
           fillcolor="#3b393e"];

    tree [shape=none, margin=0, label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="7"
             bgcolor="#322f34" color="#635850">
        <tr><td bgcolor="#3b393e" colspan="2">
          <font color="#efd5c5" point-size="17"><b>the tree</b></font><br/>
          <font color="#8f8886" point-size="11">one nested persistent map, one atomic reference</font>
        </td></tr>
        <tr><td align="left"><font color="#b0a0cf">/buf/?name</font></td>
            <td align="left"><font color="#8f8886">text point mark mode file prop readtable view selection</font></td></tr>
        <tr><td align="left"><font color="#b0a0cf">/win/?n</font></td>
            <td align="left"><font color="#8f8886">the arrangement; a split is a write</font></td></tr>
        <tr><td align="left"><font color="#b0a0cf">/proc/?name</font></td>
            <td align="left"><font color="#8f8886">everything that runs, at any blast radius</font></td></tr>
        <tr><td align="left"><font color="#b0a0cf">/err/?id</font></td>
            <td align="left"><font color="#8f8886">a fault, its restarts still live</font></td></tr>
        <tr><td align="left"><font color="#b0a0cf">/syntax/?lang</font></td>
            <td align="left"><font color="#8f8886">a language: its grammar and what it paints</font></td></tr>
        <tr><td align="left"><font color="#b0a0cf">/surface/?name</font></td>
            <td align="left"><font color="#8f8886">what wayland shows</font></td></tr>
        <tr><td align="left"><font color="#b0a0cf">/key/?map/?chord</font></td>
            <td align="left"><font color="#8f8886">bindings, as places</font></td></tr>
        <tr><td align="left"><font color="#b0a0cf">/sh/${cmd}</font></td>
            <td align="left"><font color="#8f8886">the one place a command line runs</font></td></tr>
        <tr><td align="left"><font color="#b0a0cf">/theme /face /style</font></td>
            <td align="left"><font color="#8f8886">resolved on read; a selector names its own path</font></td></tr>
        <tr><td align="left"><font color="#b0a0cf">/host/?name</font></td>
            <td align="left"><font color="#8f8886">another node, mirrored</font></td></tr>
        <tr><td bgcolor="#3b393e" align="left"><font color="#efd5c5">read</font></td>
            <td bgcolor="#3b393e" align="left"><font color="#8f8886">a slot read and a walk; no lock, safe in any receive</font></td></tr>
        <tr><td bgcolor="#3b393e" align="left"><font color="#efd5c5">write</font></td>
            <td bgcolor="#3b393e" align="left"><font color="#8f8886">a compare-and-swap onto a new root</font></td></tr>
      </table>>];

    prov  -> tree [dir=both, color="#51b04f", fontcolor="#8f8886",
                   label="clauses at a subtree\l:read :write :verbs :ls :doc\l"];
    store -> tree [dir=both, color="#51b04f", label=":keep  :max"];
    { rank=same; prov; store; }
  }

  subgraph cluster_editor {
    label="editor"; labeljust=l; fontsize=14; fontcolor="#b0a0cf";
    color="#635850"; style="rounded,dashed";
    ed [label="its own SBCL image\lxdg-shell toplevel, cairo into shm\lpanes, mode line, echo line\lxkb keys, client-side repeat\l"];
  }
  subgraph cluster_desktop {
    label="desktop"; labeljust=l; fontsize=14; fontcolor="#b0a0cf";
    color="#635850"; style="rounded,dashed";
    de [label="its own SBCL image\lwlr-layer-shell surfaces\lbar, echo strip, toggled panels\l"];
  }
  subgraph cluster_wm {
    label="window manager"; labeljust=l; fontsize=14; fontcolor="#b0a0cf";
    color="#635850"; style="rounded,dashed";
    wm [label="its own SBCL image\lriver window-management protocol\lpolicy is /wm; the compositor obeys\l"];
  }
  subgraph cluster_cli {
    label="pine - the command line"; labeljust=l; fontsize=14;
    fontcolor="#b0a0cf"; color="#635850"; style="rounded,dashed";
    cli [label="read write watch diff eval\lstart stop restart status\l"];
  }

  tree -> ed [color="#ffaacf", label="  :widgets  :rows-patch"];
  ed -> tree [color="#57b0ff", label="  :key  :resize  :refresh"];
  tree -> de [color="#ffaacf", label="  :widgets  :panel  :style"];
  de -> tree [color="#57b0ff", label="  :widget-action  :hint"];
  tree -> wm [color="#ffaacf", label="  the layout it computed"];
  wm -> tree [color="#57b0ff", label="  what the compositor has"];
  tree -> cli [dir=both, color="#51b04f", label="  one ask, one answer"];

  node2 [label="another pine, another machine\lmirrored, not queried\l",
         fillcolor="#3b393e", fontcolor="#8f8886"];
  tree -> node2 [dir=both, color="#51b04f",
                 label="  each commit ships the paths that moved"];


}
