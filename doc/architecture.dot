digraph pine {
  rankdir=TB; splines=spline; compound=true;
  graph [fontname="sans-serif", fontsize=22, ranksep=1.0, nodesep=0.5,
         bgcolor="#232025", labelloc=t, fontcolor="#efd5c5",
         label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="3">
           <tr><td colspan="2"><font point-size="24" color="#efd5c5">pine: one namespace, one protocol over it</font></td></tr>
           <tr><td align="right"><font color="#51b04f" point-size="16">==</font></td>
               <td align="left"><font color="#8f8886" point-size="13">read / write / watch a node</font></td></tr>
           <tr><td align="right"><font color="#ffaacf" point-size="16">==</font></td>
               <td align="left"><font color="#8f8886" point-size="13">a place moved, so whoever watched it hears</font></td></tr>
           <tr><td align="right"><font color="#57b0ff" point-size="16">==</font></td>
               <td align="left"><font color="#8f8886" point-size="13">what happened, written back as a value</font></td></tr>
           <tr><td colspan="2"><font color="#8f8886" point-size="12">a dashed border is an operating-system process of its own. every arrow across one<br/>carries data and nothing else, so neither side can hang or crash the other</font></td></tr>
         </table>>];
  node  [fontname="sans-serif", fontsize=14, shape=box, style="rounded,filled",
         color="#635850", fontcolor="#efd5c5", fillcolor="#322f34",
         margin="0.20,0.12"];
  edge  [fontname="sans-serif", fontsize=12, color="#8f8886",
         fontcolor="#8f8886", penwidth=1.2];

  subgraph cluster_daemon {
    label="the daemon: one headless image, no display";
    labeljust=l; fontsize=17; fontcolor="#b0a0cf";
    color="#635850"; style="rounded,dashed"; penwidth=2;

    tree [shape=none, margin=0, label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="7"
             bgcolor="#322f34" color="#635850">
        <tr><td bgcolor="#3b393e" colspan="2">
          <font color="#efd5c5" point-size="17"><b>the namespace</b></font><br/>
          <font color="#8f8886" point-size="11">everything addressable is a node, reached by path</font>
        </td></tr>
        <tr><td align="left"><font color="#b0a0cf">/text/?name</font></td>
            <td align="left"><font color="#8f8886">a document, and the regions its mode gives it</font></td></tr>
        <tr><td align="left"><font color="#b0a0cf">/window/?n</font></td>
            <td align="left"><font color="#8f8886">what is shown where; a split is a write</font></td></tr>
        <tr><td align="left"><font color="#b0a0cf">/surface/?name</font></td>
            <td align="left"><font color="#8f8886">a widget tree, its role, and whether it is up</font></td></tr>
        <tr><td align="left"><font color="#b0a0cf">/dev /sh /file</font></td>
            <td align="left"><font color="#8f8886">what the machine has, and what it will run</font></td></tr>
        <tr><td align="left"><font color="#b0a0cf">/cmd /mode /proc /system</font></td>
            <td align="left"><font color="#8f8886">what can be run, what is running, what is loaded</font></td></tr>
      </table>>];

    values [label="values\lfset in a box, no locks\lone table per registry\l", fillcolor="#3b393e"];
    conc   [label="sento\lactors, one wheel\lthreads only where it blocks\l", fillcolor="#3b393e"];
    derived [label="derived nodes\lrecord what they read\la write stirs exactly those\l", fillcolor="#3b393e"];
    store  [label="store: sqlite\lwrite-through, one table\l", fillcolor="#3b393e"];
    systems [label="the systems it loaded\ltext, host, edit, desk, wm\leach one a job you can stop\l", fillcolor="#3b393e"];
    faults [label="faults\lthe thread stands where it broke\lits restarts are what you take\l", fillcolor="#3b393e"];

    { rank=same; derived; store; values; conc; }
    { rank=same; systems; faults; }
    tree -> derived [color="#51b04f", dir=both, label="stir / read"];
    tree -> store   [color="#51b04f", label="keep"];
    tree -> values  [style=invis];
    tree -> conc    [style=invis];
    tree -> systems [color="#51b04f", dir=both];
    faults -> systems [color="#8f8886", constraint=false,
                       label="the debugger document"];
  }

  subgraph cluster_peer {
    label="a peer: another pine, mounted and evaluated in";
    labeljust=l; fontsize=15; fontcolor="#b0a0cf";
    color="#635850"; style="rounded,dashed"; penwidth=2;
    pa [label="one wayland surface per pine surface\llayer or toplevel, as the role says\lpaints widgets onto cairo\l"];
  }

  subgraph cluster_image {
    label="an image: another sbcl, here or on another machine";
    labeljust=l; fontsize=15; fontcolor="#b0a0cf";
    color="#635850"; style="rounded,dashed"; penwidth=2;
    im [label="evaluated in over the wire\lstands in its own faults\l"];
  }

  cli [label="pine read / write / watch / eval\lthe same tree, from a terminal\l",
       fillcolor="#2b282d"];

  systems -> pa [style=invis];
  faults -> im [style=invis];

  tree -> pa [color="#ffaacf", ltail=cluster_daemon, constraint=false,
              label="/surface/?/wire moved,\land /?/where says where\l"];
  pa -> tree [color="#57b0ff", lhead=cluster_daemon, constraint=false,
              label="/key, /surface/?/click,\l/surface/?/size\l"];

  faults -> im [color="#57b0ff", dir=both,
                label="a fault comes home\lwith its restarts\l"];

  cli -> tree [color="#51b04f", dir=both, lhead=cluster_daemon];
}
